    "100 〜 999 から出題されます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefragt werden Zahlen von 100 bis 999."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions are drawn from 100 to 999."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecen números del 100 al 999."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecen números del 100 al 999."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nombres vont de 100 à 999."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I numeri vanno da 100 a 999."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100 〜 999 から出題されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100~999 사이의 수가 출제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecem números de 100 a 999."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 100～999 里出题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 100～999 之間出題。"
          }
        }
      }
    },
    "1000 〜 9999 のうち、2・3・5 の倍数を除いた数から出題されます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefragt werden Zahlen von 1000 bis 9999, ohne Vielfache von 2, 3 und 5."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions are drawn from 1000 to 9999, excluding multiples of 2, 3 and 5."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecen números del 1000 al 9999, sin contar los múltiplos de 2, 3 y 5."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecen números del 1000 al 9999, sin contar los múltiplos de 2, 3 y 5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nombres vont de 1000 à 9999, sans les multiples de 2, 3 et 5."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I numeri vanno da 1000 a 9999, esclusi i multipli di 2, 3 e 5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 〜 9999 のうち、2・3・5 の倍数を除いた数から出題されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1000~9999 중 2·3·5의 배수를 뺀 수가 출제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecem números de 1000 a 9999, sem os múltiplos de 2, 3 e 5."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 1000～9999 里出题，但不会出 2、3、5 的倍数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 1000～9999 之間出題，但不會出現 2、3、5 的倍數。"
          }
        }
      }
    },
