    "Notifications are turned off for this app. To get reminders, allow notifications in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für diese App deaktiviert. Um Erinnerungen zu erhalten, erlaube Mitteilungen in der App „Einstellungen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for this app. To get reminders, allow notifications in the Settings app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de esta app están desactivadas. Para recibir recordatorios, permite las notificaciones en la app Configuración."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de esta app están desactivadas. Para recibir recordatorios, permite las notificaciones en la app Ajustes."
          }
        },
        "fr": {
