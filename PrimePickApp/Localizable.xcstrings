    },
    "100 〜 999 から出題されます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions are drawn from 100 to 999."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100 〜 999 から出題されます。"
          }
        }
      }
    },
    "100 〜 999 のうち、2・3・5 の倍数を除いた数から出題されます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions are drawn from 100 to 999, excluding multiples of 2, 3 and 5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100 〜 999 のうち、2・3・5 の倍数を除いた数から出題されます。"
          }
        }
      }
    },
    "1 〜 99 から出題されます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions are drawn from 1 to 99."
