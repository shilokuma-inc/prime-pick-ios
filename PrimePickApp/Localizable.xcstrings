    "素数だと思ったら右の「素数」、素数ではないと思ったら左の「ちがう」を選びます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap PRIME on the right if you think it is a prime number, or NOT PRIME on the left if you do not."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素数だと思ったら右の「素数」、素数ではないと思ったら左の「ちがう」を選びます。"
          }
        }
      }
    },
    "表示された数が素数かどうかを答えます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer whether the number shown is a prime number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示された数が素数かどうかを答えます。"
