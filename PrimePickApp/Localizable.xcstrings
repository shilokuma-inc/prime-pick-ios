{
  "sourceLanguage": "en",
  "strings": {
    "%lld is a prime number": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld is a prime number"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld は素数"
          }
        }
      }
    },
    "%lld is not a prime number": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld is not a prime number"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld は素数ではありません"
          }
        }
      }
    },
