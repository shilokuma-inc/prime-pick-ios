    "Unanswered questions will be left blank and your result will be final. You can't try today's challenge again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Fragen bleiben unbeantwortet und dein Ergebnis steht fest. Das heutige Tagesquiz kannst du nicht noch einmal spielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unanswered questions will be left blank and your result will be final. You can't try today's challenge again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preguntas sin responder quedarán en blanco y tu resultado será definitivo. No podrás volver a jugar el reto de hoy."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preguntas sin responder quedarán en blanco y tu resultado será definitivo. No podrás volver a jugar el reto de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les questions sans réponse resteront vides et votre résultat sera définitif. Vous ne pourrez pas retenter le défi du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le domande senza risposta resteranno vuote e il risultato sarà definitivo. Non potrai riprovare la sfida del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ解いていない問題は未解答のまま結果が確定し、今日のチャレンジにはもう挑戦できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 풀지 않은 문제는 미응답으로 처리되어 결과가 확정되며, 오늘의 챌린지에는 다시 도전할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As perguntas não respondidas ficarão em branco e seu resultado será definitivo. Você não poderá jogar o desafio de hoje de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没答的题会按未作答处理，成绩随即确定，今天不能再挑战了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒作答的題目會視為未作答並確定成績，今天就不能再挑戰了。"
          }
        }
      }
    },
