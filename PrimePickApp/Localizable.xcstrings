            "state": "translated",
            "value": "判断屏幕上的数是不是质数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "判斷畫面上的數是不是質數。"
          }
        }
      }
    },
