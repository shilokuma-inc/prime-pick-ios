            "state": "translated",
            "value": "要接收提醒嗎？"
          }
        }
      }
    },
    "We'll remind you at %@ on days you haven't played the Daily Challenge yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir erinnern dich um %@ an Tagen, an denen du das Tagesquiz noch nicht gespielt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll remind you at %@ on days you haven't played the Daily Challenge yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisaremos a las %@ los días que aún no hayas jugado el reto del día."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisaremos a las %@ los días que aún no hayas jugado el reto del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous le rappellerons à %@ les jours où vous n’avez pas encore joué au défi du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avviseremo alle %@ nei giorni in cui non hai ancora giocato la sfida del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のチャレンジをまだ解いていない日の %@ にお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 챌린지를 아직 하지 않은 날 %@에 알려 드립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos te lembrar às %@ nos dias em que você ainda não jogou o desafio do dia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当天还没玩每日挑战时，我们会在 %@ 提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天還沒玩每日挑戰時，我們會在 %@ 提醒你。"
          }
        }
      }
    },
