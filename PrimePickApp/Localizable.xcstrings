          "stringUnit": {
            "state": "translated",
            "value": "Quer receber um lembrete?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要接收提醒吗？"
          }
        },
        "zh-Hant": {
