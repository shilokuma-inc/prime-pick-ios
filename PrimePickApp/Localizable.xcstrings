    "タイムアタックでは制限時間まで出題が続きます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Blitzrunde kommen so lange Fragen, bis die Zeit um ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Time Attack, questions keep coming until time runs out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Contrarreloj, las preguntas siguen hasta que se acabe el tiempo."
          }
