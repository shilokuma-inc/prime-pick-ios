    "Notifications aren't allowed. You can turn reminders on later in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen wurden nicht erlaubt. Du kannst Erinnerungen später in den Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications aren't allowed. You can turn reminders on later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se permitieron las notificaciones. Puedes activar los recordatorios más tarde en Configuración."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se permitieron las notificaciones. Puedes activar los recordatorios más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications n’ont pas été autorisées. Vous pourrez activer les rappels plus tard dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche non sono state consentite. Puoi attivare i promemoria più tardi nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が許可されませんでした。リマインドは、あとから設定画面でオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 허용되지 않았습니다. 나중에 설정 화면에서 알림을 켤 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações não foram permitidas. Você pode ativar os lembretes depois em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未允许通知。你可以稍后在设置中开启提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未允許通知。你可以稍後在設定中開啟提醒。"
          }
        }
      }
    },
