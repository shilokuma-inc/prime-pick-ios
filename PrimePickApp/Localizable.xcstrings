    "制限時間内にできるだけ高いスコアを目指します。連続で正解するとコンボになり、点が増えます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol so viele Punkte wie möglich, bevor die Zeit abläuft. Richtige Antworten in Folge ergeben eine Combo und bringen mehr Punkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for the highest score you can before time runs out. Consecutive correct answers build a combo and earn more points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue todos los puntos que puedas antes de que se acabe el tiempo. Los aciertos seguidos forman un combo y suman más puntos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue todos los puntos que puedas antes de que se acabe el tiempo. Los aciertos seguidos forman un combo y suman más puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez un maximum de points avant la fin du temps. Enchaînez les bonnes réponses pour faire un combo et gagner plus de points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai più punti che puoi prima che scada il tempo. Le risposte giuste di fila formano una combo e valgono più punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限時間内にできるだけ高いスコアを目指します。連続で正解するとコンボになり、点が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 시간 안에 최대한 높은 점수를 노립니다. 연속으로 맞히면 콤보가 되어 점수가 더 올라갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o máximo de pontos que puder antes de o tempo acabar. Acertos seguidos formam um combo e valem mais pontos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在时间用完前尽量拿到高分。连续答对会形成连击，得分更多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在時間結束前盡量拿到高分。連續答對就會形成連擊，分數更多。"
          }
        }
      }
    },
    "コンボが %lld 以上のときは、早く答えるほど速度ボーナスが付きます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab einer Combo von %lld gibt es für schnelle Antworten einen Tempo-Bonus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While your combo is %lld or more, faster answers earn a speed bonus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un combo de %lld o más, cuanto más rápido respondas, más extra por rapidez ganas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un combo de %lld o más, cuanto más rápido respondas, más extra por rapidez ganas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir d’un combo de %lld, plus vous répondez vite, plus votre bonus de rapidité est élevé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una combo di %lld o più, più rispondi in fretta, più bonus velocità ottieni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンボが %lld 以上のときは、早く答えるほど速度ボーナスが付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콤보가 %lld 이상일 때는 빨리 답할수록 스피드 보너스를 받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um combo de %lld ou mais, quanto mais rápido você responder, maior o bônus de velocidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连击达到 %lld 以上时，答得越快，速度加分越多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連擊達到 %lld 以上時，答得越快，速度加分越多。"
          }
        }
      }
    },
    "間違えた直後の 0.5 秒はボタンを押せません。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer falschen Antwort sind die Tasten 0,5 Sekunden lang gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The buttons are locked for 0.5 seconds after a wrong answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras un error, los botones se bloquean durante medio segundo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras un error, los botones se bloquean durante medio segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une erreur, les boutons sont bloqués pendant une demi-seconde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo una risposta sbagliata, i pulsanti si bloccano per mezzo secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違えた直後の 0.5 秒はボタンを押せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틀린 직후 0.5초 동안은 버튼을 누를 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de um erro, os botões ficam travados por meio segundo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答错后的 0.5 秒内无法点按按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "答錯後的 0.5 秒內無法點按按鈕。"
          }
        }
      }
    },
    "難易度と制限時間ごとに自己ベストが記録されます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bestleistung wird für jede Schwierigkeit und jedes Zeitlimit gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal best is saved for each difficulty and time limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda tu mejor marca para cada dificultad y límite de tiempo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda tu mejor marca para cada dificultad y límite de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre record personnel est enregistré pour chaque difficulté et chaque durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo record personale viene salvato per ogni difficoltà e limite di tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "難易度と制限時間ごとに自己ベストが記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "난이도와 제한 시간별로 최고 기록이 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu recorde pessoal fica salvo para cada dificuldade e limite de tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种难度和时间限制都会分别记录个人最佳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每種難度和時間限制都會分別保存個人最佳紀錄。"
          }
        }
      }
    },
    "間違えると点が減り（Easy %lld / Normal %lld / Hard %lld / Expert %lld）、残り時間も %lld 秒減ります。スコアは 0 点より下にはなりません。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine falsche Antwort kostet Punkte (Leicht %1$lld / Normal %2$lld / Schwer %3$lld / Experte %4$lld) und Zeit (%5$lld Sek.). Deine Punktzahl fällt nie unter 0."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wrong answer costs points (Easy %1$lld / Normal %2$lld / Hard %3$lld / Expert %4$lld) and %5$lld seconds. Your score never drops below 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada error resta puntos (Fácil %1$lld / Normal %2$lld / Difícil %3$lld / Experto %4$lld) y te quita %5$lld s del tiempo. Tus puntos nunca bajan de 0."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada error resta puntos (Fácil %1$lld / Normal %2$lld / Difícil %3$lld / Experto %4$lld) y te quita %5$lld s del tiempo. Tus puntos nunca bajan de 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur fait perdre des points (Facile %1$lld / Normal %2$lld / Difficile %3$lld / Expert %4$lld) et retire %5$lld s au chrono. Le score ne descend jamais sous 0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una risposta sbagliata costa punti (Facile %1$lld / Normale %2$lld / Difficile %3$lld / Esperto %4$lld) e toglie %5$lld s al tempo. Il punteggio non scende mai sotto 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違えると点が減り（Easy %1$lld / Normal %2$lld / Hard %3$lld / Expert %4$lld）、残り時間も %5$lld 秒減ります。スコアは 0 点より下にはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틀리면 점수가 깎이고(쉬움 %1$lld / 보통 %2$lld / 어려움 %3$lld / 전문가 %4$lld), 남은 시간도 %5$lld초 줄어듭니다. 점수는 0점 아래로 내려가지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada erro tira pontos (Fácil %1$lld / Normal %2$lld / Difícil %3$lld / Especialista %4$lld) e %5$lld s do tempo. Sua pontuação nunca fica abaixo de 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答错会扣分（简单 %1$lld / 普通 %2$lld / 困难 %3$lld / 专家 %4$lld），剩余时间也会减少 %5$lld 秒。得分不会低于 0 分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "答錯會扣分（簡單 %1$lld / 普通 %2$lld / 困難 %3$lld / 專家 %4$lld），剩餘時間也會減少 %5$lld 秒。分數不會低於 0 分。"
          }
        }
      }
    },
