{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "ホーム画面のアプリ名（言語ごと。Issue #524）。アプリの中の名前（シェアの文・ロゴの読み上げ）もここから読む（AppName）。ロゴの文字は Localizable.xcstrings の TitleLogoLines。App Store の名前は AppStore/metadata/<言語>.json の name",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echt prim?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prime or Not?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Será primo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primo o no?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "素数なの？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소수냐 아니냐"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Será primo?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是不是质数？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是不是質數？"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "comment" : "ATT（App Tracking Transparency）のダイアログの説明文",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Tracking erlaubst, können wir dir anhand deiner Aktivitäten in anderen Apps und auf Websites Werbung zeigen, die besser zu deinen Interessen passt. Auch ohne Erlaubnis siehst du weiterhin Werbung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allowing tracking helps us show ads that better match your interests, based on your activity in other apps and websites. You'll still see ads if you don't allow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo permites, te mostraremos anuncios más acordes con tus intereses, según tu actividad en otras apps y sitios web. Si no lo permites, seguirás viendo anuncios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser le suivi nous permet de vous montrer des publicités plus adaptées à vos centres d’intérêt, selon votre activité dans d’autres apps et sur d’autres sites web. Si vous refusez, des publicités s’afficheront quand même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentire il tracciamento ci aiuta a mostrarti annunci più in linea con i tuoi interessi, in base alla tua attività in altre app e siti web. Se non lo consenti, vedrai comunque annunci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可すると、ほかのアプリやWebサイトでの利用状況をもとに、興味に合った広告が表示されやすくなります。許可しなくても広告は表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용하면 다른 앱 및 웹사이트에서의 활동을 바탕으로 관심사에 더 잘 맞는 광고가 표시됩니다. 허용하지 않아도 광고는 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você permitir, vamos mostrar anúncios mais alinhados aos seus interesses, com base na sua atividade em outros apps e sites. Se não permitir, você continuará vendo anúncios."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许跟踪后，我们可以根据你在其他 App 和网站上的活动，为你展示更符合你兴趣的广告。即使不允许，你仍会看到广告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許追蹤後，我們能依據你在其他 App 和網站上的活動，顯示更符合你興趣的廣告。即使不允許，仍會顯示廣告。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
