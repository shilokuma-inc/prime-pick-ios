{
  "sourceLanguage" : "en",
  "strings" : {
    "NSUserTrackingUsageDescription" : {
      "comment" : "ATT（App Tracking Transparency）のダイアログの説明文",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allowing tracking helps us show ads that better match your interests, based on your activity in other apps and websites. You'll still see ads if you don't allow it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可すると、ほかのアプリやWebサイトでの利用状況をもとに、興味に合った広告が表示されやすくなります。許可しなくても広告は表示されます。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
