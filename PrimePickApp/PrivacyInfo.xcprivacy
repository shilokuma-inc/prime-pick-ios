<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- アプリのコード自身はトラッキングしない。ATT で許可した人へのパーソナライズ広告（IDFA）は Google Mobile Ads が扱い、
	     Device ID の「トラッキングあり」は SDK 側のマニフェストが宣言する。true にするとドメインを 1 つ以上並べる必要があり、
	     空のままだと App Store Connect で ITMS-91064 になる（#508） -->
	<key>NSPrivacyTracking</key>
	<false/>
	<!-- NSPrivacyTrackingDomains は書かない。アプリ自身はトラッキングのためのドメインに通信せず（広告の通信は Google Mobile Ads が行う）、
	     空の配列でキーを残すと ITMS-91064 になることがあるので、キーごと外す（#508） -->
	<!-- 収集するデータは Google Mobile Ads・UMP・Firebase のマニフェストが SDK 側で宣言する。アプリ自身が集めるものは無い -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- 自己ベスト・デイリーチャレンジの記録・テーマの設定をアプリ自身の UserDefaults に保存する -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
